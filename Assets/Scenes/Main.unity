  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: 
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\rMantarys, ruled by Lord Robert Bjorn, was able to withstand the siege
    of King Pater Patriae Voltier for about 60 days, and the siege resulted in the
    death of a total of 40 thousand soldiers of both sides. After The Great Continental
